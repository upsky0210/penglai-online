# Client build-time settings (Vite). For local overrides copy to client/.env.local
# (ignored by git). All of these end up inside the public JS bundle — never put
# ADMIN_TOKEN or any other secret here.

# Google Web OAuth Client ID (same value as the server's GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=

# Only when the client is hosted apart from the server (e.g. GitHub Pages).
# Leave empty for the classroom LAN / nginx deployment.
# Must be https:// when the page is served over https:// — browsers block
# ws:// and http:// calls from an https page.
VITE_SERVER_URL=

# Sub-path the site is served from. GitHub Pages: /<repo-name>/
VITE_BASE=/
