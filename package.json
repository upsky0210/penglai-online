{
  "name": "penglai-online",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "backup:db": "node scripts/backup-sqlite.mjs",
    "restore:db": "node scripts/restore-sqlite.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:multi": "node scripts/multiplayer-smoke.mjs",
    "smoke:interactable": "node scripts/interactable-smoke.mjs",
    "smoke:warehouse": "node scripts/warehouse-smoke.mjs",
    "smoke:cavern": "node scripts/cavern-smoke.mjs",
    "smoke:archive": "node scripts/archive-smoke.mjs",
    "smoke:observatory": "node scripts/observatory-smoke.mjs",
    "smoke:observatory-balance": "node scripts/observatory-balance-check.mjs",
    "smoke:quest-lock": "node scripts/quest-lock-smoke.mjs",
    "smoke:save-roundtrip": "node scripts/save-roundtrip-smoke.mjs",
    "smoke:message-validation": "node scripts/message-validation-smoke.mjs",
    "smoke:save-failure-retry": "node scripts/save-failure-retry-smoke.mjs",
    "smoke:broadcast-budget": "node scripts/broadcast-budget-smoke.mjs",
    "smoke:classroom-load": "node scripts/classroom-load-probe.mjs",
    "audit:ui-text": "node scripts/audit-ui-text.mjs",
    "check:p8-g": "node scripts/p8-g-density-check.mjs",
    "check:beta:v02": "node scripts/beta-v02-check.mjs && npm run audit:ui-text && npm run check:p8-g && npm run typecheck && npm --workspace client run build",
    "check:beta": "npm run typecheck && npm --workspace client run build && npm run smoke && npm run smoke:multi && npm run smoke:save-roundtrip && npm run smoke:message-validation && npm run smoke:save-failure-retry && npm run smoke:broadcast-budget",
    "check:release": "node scripts/release-check.mjs",
    "typecheck": "npm --workspace shared run typecheck && npm --workspace server run typecheck && npm --workspace client run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
