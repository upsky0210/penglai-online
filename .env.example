PORT=8787
PENGLAI_DB_PATH=./server/data/penglai.sqlite
PENGLAI_BACKUP_DIR=./server/backups
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAIN=
AUTH_CORS_ORIGIN=http://localhost:5174
ADMIN_TOKEN=change-this-admin-token
# Test-only. Set to 1 to let /auth/google accept mock:<email> credentials so the
# login/save-binding flow can be tested without a real Google Client ID. Keep empty
# (OFF) in production. Pair with the client flag VITE_AUTH_ALLOW_MOCK=1.
AUTH_ALLOW_MOCK=
